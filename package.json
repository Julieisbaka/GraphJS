{
  "name": "@julieisbaka/graphjs",
  "version": "0.5.3",
  "description": "A zero-dependency, lightweight JavaScript graphing core with powerful plugin hooks.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./utils": {
      "types": "./src/utils.d.ts",
      "default": "./src/core/utils.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "keywords": [
    "graph",
    "chart",
    "plugin",
    "canvas",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julieisbaka/GraphJS.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node --check src/index.js src/core/*.js",
    "test": "node ./scripts/run-tests.mjs",
    "build": "node ./scripts/build.mjs"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "esbuild": "^0.25.0",
    "terser": "^5.46.2"
  }
}
